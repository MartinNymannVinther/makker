# Kopiér til .env og indsæt jeres egne nøgler. Alle er valgfrie: en udbyder
# uden nøgle vises ikke i dropdownen.

# Anthropic (Claude Sonnet / Claude Opus).
ANTHROPIC_API_KEY=sk-ant-...

# Mistral (Mistral Large / Mistral Small).
MISTRAL_API_KEY=...

# fal.ai — billedmodellerne (FLUX). Uden den vises de slet ikke.
# Hentes på fal.ai under Keys.
# FAL_KEY=...

# Ollama — lokale modeller. Kræver ingen nøgle; sæt kun adressen hvis
# Ollama ikke ligger på standardporten.
# OLLAMA_URL=http://localhost:11434

# Hvilken model der oversætter billedprompter til engelsk vælges under
# Indstillinger i UI'et (gemmes i settings.json), ikke her.
